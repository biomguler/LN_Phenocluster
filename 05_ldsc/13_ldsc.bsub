#!/bin/bash
#BSUB -q long
#BSUB -J ldsc_binary_rg[1-17]
#BSUB -n 1                  # Request 1 core
#BSUB -R "span[ptile=1]"    # Request 1 core per node
#BSUB -R "rusage[mem=8GB]"  # Request 8GB memory
#BSUB -o /path/to/logs/ldsc_%J_%I.out
#BSUB -e /path/to/logs/ldsc_%J_%I.err

# Load modules
module load miniconda/23.5.2

# Set environment
source ~/.bashrc
conda activate /path/to/conda_envs/ldsc_env

# Move to working directory
cd /path/to/working/directory

# Define sumstat file
sumstat_file="munged_ldsc.sumstat.list"

# Read the correct line from sumstat file (Skipping the header)
line=$(sed -n "$((LSB_JOBINDEX + 1))p" "$sumstat_file")

# Assign variables from the line
test_trait=$(echo "$line" | cut -f1)
test_trait_path=$(echo "$line" | cut -f5)

# Loop through traits (assuming fixed 17 traits)
for i in {1..17}; do
    current_line=$(sed -n "$((i + 1))p" "$sumstat_file")
    current_trait=$(echo "$current_line" | cut -f1)
    current_trait_path=$(echo "$current_line" | cut -f5)

    # Define output name
    output_name="${test_trait}_${current_trait}_out"

    # Run LDSC rg analysis
    python /path/to/ldsc/ldsc.py \
    --rg "${test_trait_path},${current_trait_path}" \
    --ref-ld-chr /path/to/eur_w_ld_chr/ \
    --w-ld-chr /path/to/eur_w_ld_chr/ \
    --out "${output_name}"
done
