#!/bin/bash
#BSUB -q long
#BSUB -J ldsc_munge[1-17]
#BSUB -n 1                  # Request 1 core
#BSUB -R "span[ptile=1]"    # Request 1 core per node
#BSUB -R "rusage[mem=8GB]"  # Request 8GB memory
#BSUB -o /path/to/logs/ldsc_munge_%J_%I.out
#BSUB -e /path/to/logs/ldsc_munge_%J_%I.err

# Load modules
module load miniconda/23.5.2

# Set environment
source ~/.bashrc
conda activate /path/to/conda_envs/ldsc_env

# Move to working directory
cd /path/to/working/directory

# Define sumstat file
sumstat_file="ldsc.sumstat.list"

# Read the correct line from sumstat file (Skipping the header)
line=$(sed -n "$((LSB_JOBINDEX + 1))p" "$sumstat_file")

# Assign variables from the line
trait=$(echo "$line" | cut -f1)
trait_path=$(echo "$line" | cut -f5)

# Define output name
output_name="${trait}_munged"

# Run LDSC munge_sumstats
python /path/to/ldsc/munge_sumstats.py \
  --sumstats "${trait_path}" \
  --chunksize 500000 \
  --merge-alleles /path/to/w_hm3.noMHC.snplist \
  --maf-min 0.05 \
  --snp SNP \
  --N-col N \
  --a1 A1 \
  --a2 A2 \
  --p P \
  --out "${output_name}"
