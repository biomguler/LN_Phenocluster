#!/bin/bash
#BSUB -q long
#BSUB -J gwaslab_ldsc[1-17]
#BSUB -n 8
#BSUB -R "rusage[mem=32GB]"
#BSUB -o /path/to/output/gwaslab_%J_%I.out
#BSUB -e /path/to/output/gwaslab_%J_%I.err

# Load modules
module load miniconda/23.5.2

# Activate conda environment
source ~/.bashrc
conda activate /path/to/conda_envs/gwaslab_test

# Move to the working directory
cd /path/to/working/directory

# Read sumstat file
sumstat_file="sumstat.list"

# Ensure LSB_JOBINDEX is set
if [[ -z "$LSB_JOBINDEX" ]]; then
    echo "ERROR: LSB_JOBINDEX is not set. Exiting."
    exit 1
fi

# Read the correct line from sumstat.list (Skipping the header)
line=$(sed -n "$((LSB_JOBINDEX + 1))p" "$sumstat_file")

# Assign variables from the line
trait=$(echo "$line" | cut -f1)
neff=$(echo "$line" | cut -f4)
trait_path=$(echo "$line" | cut -f5)

# Validate extracted values
if [[ -z "$trait" || -z "$trait_path" || -z "$neff" ]]; then
    echo "ERROR: One or more extracted variables are empty. Check sumstat.list format."
    exit 1
fi

# Debugging Output
echo "Running analysis for:"
echo "Trait: $trait"
echo "Path: $trait_path"
echo "N_eff: $neff"

# Run Python script with extracted variables
python3 - "$trait" "$trait_path" "$neff" <<EOF
import sys
import gwaslab as gl

trait = sys.argv[1]
trait_path = sys.argv[2]
neff = sys.argv[3]

print(f"Processing trait: {trait}")
print(f"Using sumstats file: {trait_path}")
print(f"Effective sample size: {neff}")

# Load the sumstats file
sumstats = gl.Sumstats(trait_path,
                  snpid="SNP",
                  chrom="CHR",
                  pos="POS",
                  ea="ALT",
                  nea="REF",
                  beta="BETA",
                  se="SE",
                  p="PVAL",
                  build="19",             
                  n=int(neff),
                  verbose=False)

sumstats.basic_check()

sumstats.assign_rsid(ref_rsid_tsv=gl.get_path("1kg_dbsnp151_hg19_auto"),
                     ref_rsid_vcf="/path/to/reference/GCF_000001405.25.gz",
                     chr_dict=gl.get_number_to_NC(build="19"),
                     n_cores=16)

sumstats.to_format(f"{trait}_clean_sumstats", fmt="ldsc", hapmap3=True, exclude_hla=True, md5sum=True)

EOF
