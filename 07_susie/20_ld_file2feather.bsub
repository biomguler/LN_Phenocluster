#!/bin/bash
#BSUB -q long
#BSUB -J ld_file2feather[1-79]
#BSUB -n 1                          # Request 1 core per job
#BSUB -R "rusage[mem=16GB]"        # Request 16GB of memory per job
#BSUB -o logs/ld_file2feather_%J_%I.out  # Output logs
#BSUB -e logs/ld_file2feather_%J_%I.err  # Error logs

# Load Python and activate virtual environment
module load python/3.12.1
source ~/myenv/bin/activate  # <-- Replace with your conda or venv path

# Change to working directory
cd /path/to/susie_project

# File with list of LD file prefixes (one per line)
ld_files="ld_files.list"

# Get the file path for this job index
file_to_process=$(sed -n "${LSB_JOBINDEX}p" "$ld_files")

# Run the LD processing script
python3 19_process_ld.py "$file_to_process"
